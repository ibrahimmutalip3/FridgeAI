# Uncomment this line to define a global platform for your project
# NOTE: Flutter 3.47 raised its own minimum supported iOS version from 13.0
# to 15.0 (to prepare for Xcode 27 / iOS 27). Building with Flutter 3.47+
# while this is set below 15.0 makes CocoaPods fail with:
#   "CocoaPods could not find compatible versions for pod \"Flutter\": ...
#    required a higher minimum deployment target."
# Keep this in sync with IPHONEOS_DEPLOYMENT_TARGET in Runner.xcodeproj.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler (iOS) ships every permission's native code behind a
    # compile-time flag that defaults to OFF, so that apps which don't use a
    # given permission don't get flagged by Apple's review for unused
    # sensitive APIs. Because none of these flags were enabled here, calling
    # Permission.camera/.photos.request() at runtime was a silent no-op:
    # no system prompt ever appeared, so iOS never even created a
    # Camera/Photos row under Settings > FridgeAI for the user to toggle.
    # Only enable the permissions this app actually asks for.
    #
    # NOTE: the whole list (including '$(inherited)') is assigned in one
    # flat array via `||=`. Appending the new entries afterwards with `<<`
    # instead nests them as a single sub-array element, which makes Xcode's
    # -D flag generation choke with "Macro name must be an identifier" on
    # every Pods target — not just this one.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end
end
