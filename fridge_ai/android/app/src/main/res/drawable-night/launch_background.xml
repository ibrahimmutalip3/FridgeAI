<?xml version="1.0" encoding="utf-8"?>
<!--
  Native (pre-Flutter-engine) launch screen. Mirrors the FridgeAI app icon:
  a warm orange vertical gradient with the white script "G" + sparkle mark
  centered on top. This is shown for a brief instant before the Flutter
  engine draws its first frame, at which point AnimatedSplashScreen (see
  lib/features/splash/splash_screen.dart) takes over with the full morph
  animation, using the exact same colors/logo so the handoff is seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/splashGradientTop"
                android:endColor="@color/splashGradientBottom" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
