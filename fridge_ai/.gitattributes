# Ensure Gradle wrapper scripts always use LF line endings, even on Windows.
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Force these to be treated as binary so git never rewrites their bytes
# (line-ending conversion silently corrupts jars, making Gradle/Java fail
# with "Could not find or load main class ...").
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.keystore binary
*.jks binary
